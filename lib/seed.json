[{"id": "О-001", "text": "С потолка в коридоре капает, немного, но пятно растёт. Подставили тазик", "house": "Д-10", "category": "Вода и канализация", "additional": "", "urgency": "Срочно", "recipient": "Инженерная служба", "review": 0, "source_date": "08.09.2026"}, {"id": "О-002", "text": "Окно в кухне продувает, на откосах конденсат и чёрные пятна", "house": "Д-03", "category": "Дефект в квартире", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 0, "source_date": "17.04.2026"}, {"id": "О-003", "text": "У соседей громкая музыка каждую ночь после 23:00.", "house": "Д-06", "category": "Соседи и порядок", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 0, "source_date": "19.02.2026"}, {"id": "О-004", "text": "Во дворе неделю не вывозят мусор, контейнеры переполнены, коты растаскивают.", "house": "Д-02", "category": "Уборка и благоустройство", "additional": "", "urgency": "Обычная", "recipient": "Клининг и благоустройство", "review": 0, "source_date": "21.03.2026"}, {"id": "О-005", "text": "здрасьте капает кран на кухне но это наверно наш кран да? подскажите кому звонить сантехнику", "house": "Д-01", "category": "Вода и канализация", "additional": "", "urgency": "Срочно", "recipient": "Инженерная служба", "review": 0, "source_date": "14.12.2025"}, {"id": "О-006", "text": "Плохо закрывается окно в зале, не прижимается створка.", "house": "Д-09", "category": "Дефект в квартире", "additional": "", "urgency": "Обычная", "recipient": "Гарантийный отдел", "review": 0, "source_date": "22.01.2026"}, {"id": "О-007", "text": "ПОЧЕМУ ПЕНИ??? Я ВСЁ ОПЛАТИЛ ВОВРЕМЯ!!! ВЕРНИТЕ ДЕНЬГИ!!!", "house": "Д-04", "category": "Начисления и оплата", "additional": "", "urgency": "Обычная", "recipient": "Расчётный центр", "review": 0, "source_date": "25.05.2026"}, {"id": "О-008", "text": "На детской площадке сломана горка, торчит острый край металла, дети могут пораниться.", "house": "Д-09", "category": "Уборка и благоустройство", "additional": "", "urgency": "Срочно", "recipient": "Клининг и благоустройство", "review": 0, "source_date": "10.01.2026"}, {"id": "О-009", "text": "Hello, I live in [номер квартиры скрыт]. There is smoke coming from the electrical panel in the corridor on my floor and a burning smell. Please send someone.", "house": "Д-01", "category": "Электричество", "additional": "", "urgency": "Авария", "recipient": "Аварийно-диспетчерская служба", "review": 1, "source_date": "08.09.2026"}, {"id": "О-010", "text": "Со вчерашнего вечера нет горячей воды во всей квартире. Объявлений об отключении не было.", "house": "Д-12", "category": "Вода и канализация", "additional": "", "urgency": "Срочно", "recipient": "Инженерная служба", "review": 0, "source_date": "26.03.2026"}, {"id": "О-011", "text": "СРОЧНО прорвало батарею!! кипяток льётся на пол, в комнате пар, дети дома", "house": "Д-03", "category": "Отопление", "additional": "", "urgency": "Авария", "recipient": "Аварийно-диспетчерская служба", "review": 1, "source_date": "30.04.2026"}, {"id": "О-012", "text": "Когда покрасят лавочки во дворе? Облезли совсем.", "house": "Д-02", "category": "Уборка и благоустройство", "additional": "", "urgency": "Обычная", "recipient": "Клининг и благоустройство", "review": 0, "source_date": "21.10.2025"}, {"id": "О-013", "text": "Когда планируется промывка системы отопления в этом году?", "house": "Д-07", "category": "Отопление", "additional": "", "urgency": "Обычная", "recipient": "Инженерная служба", "review": 0, "source_date": "03.03.2026"}, {"id": "О-014", "text": "Откуда в квитанции строка «целевой взнос»? Мы ни на что не соглашались.", "house": "Д-09", "category": "Начисления и оплата", "additional": "", "urgency": "Обычная", "recipient": "Расчётный центр", "review": 0, "source_date": "25.04.2026"}, {"id": "О-015", "text": "Не работает пассажирский лифт во втором подъезде с утра, грузовой тоже стоит. У нас лежачий больной на 12 этаже.", "house": "Д-06", "category": "Лифт", "additional": "", "urgency": "Срочно", "recipient": "Инженерная служба", "review": 0, "source_date": "22.08.2026"}, {"id": "О-016", "text": "Отопление так и не дали, хотя уже середина октября, по всем комнатам холодно", "house": "Д-10", "category": "Отопление", "additional": "", "urgency": "Срочно", "recipient": "Инженерная служба", "review": 0, "source_date": "22.10.2025"}, {"id": "О-017", "text": "Хочу перенести электросчётчик из коридора в квартиру, это возможно?", "house": "Д-04", "category": "Электричество", "additional": "", "urgency": "Обычная", "recipient": "Инженерная служба", "review": 0, "source_date": "06.03.2026"}, {"id": "О-018", "text": "Как вызвать такси к дому, если адрес не находит навигатор?", "house": "Д-03", "category": "Не по адресу", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 0, "source_date": "27.12.2025"}, {"id": "О-019", "text": "Нет холодной воды ни на кухне, ни в ванной с 7 утра. Это у всего стояка или только у нас?", "house": "Д-02", "category": "Вода и канализация", "additional": "", "urgency": "Срочно", "recipient": "Инженерная служба", "review": 0, "source_date": "02.11.2025"}, {"id": "О-020", "text": "Как подключить автоплатёж за коммунальные услуги?", "house": "Д-06", "category": "Начисления и оплата", "additional": "", "urgency": "Обычная", "recipient": "Расчётный центр", "review": 0, "source_date": "31.05.2026"}, {"id": "О-021", "text": "Добрый день! Подскажите, почему начисления за горячую воду выросли, хотя расход тот же. И ещё — в подвале у электрощитка что-то щёлкает, искрит и пахнет гарью, но, может, так и должно быть.", "house": "Д-01", "category": "Электричество", "additional": "Начисления и оплата", "urgency": "Авария", "recipient": "Аварийно-диспетчерская служба", "review": 1, "source_date": "11.09.2026"}, {"id": "О-022", "text": "Подскажите, могу ли я получить налоговый вычет за квартиру, купленную в вашем доме?", "house": "Д-01", "category": "Не по адресу", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 0, "source_date": "16.08.2026"}, {"id": "О-023", "text": "Подскажите, когда откроют школу в новом квартале?", "house": "Д-11", "category": "Не по адресу", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 0, "source_date": "09.05.2026"}, {"id": "О-024", "text": "Хотелось бы больше освещения и цветов у входа, возможно ли это?", "house": "Д-09", "category": "Уборка и благоустройство", "additional": "", "urgency": "Обычная", "recipient": "Клининг и благоустройство", "review": 1, "source_date": "12.11.2025"}, {"id": "О-025", "text": "Хочу сдать квартиру, вы помогаете искать арендаторов?", "house": "Д-01", "category": "Не по адресу", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 0, "source_date": "11.04.2026"}, {"id": "О-026", "text": "Плитка в ванной отходит от стены, две плитки уже треснули.", "house": "Д-08", "category": "Дефект в квартире", "additional": "", "urgency": "Обычная", "recipient": "Гарантийный отдел", "review": 0, "source_date": "24.06.2026"}, {"id": "О-027", "text": "Как оформить разрешение на перепланировку?", "house": "Д-07", "category": "Не по адресу", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 1, "source_date": "01.12.2025"}, {"id": "О-028", "text": "Почему до сих пор не включают отопление? В квартире прохладно, по вечерам +19.", "house": "Д-09", "category": "Отопление", "additional": "", "urgency": "Обычная", "recipient": "Инженерная служба", "review": 0, "source_date": "04.10.2025"}, {"id": "О-029", "text": "Кто-то выбрасывает мусор из окна, весь газон в окурках", "house": "Д-07", "category": "Соседи и порядок", "additional": "Уборка и благоустройство", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 1, "source_date": "04.01.2026"}, {"id": "О-030", "text": "Не горит свет в тамбуре первого подъезда, и заодно — когда будет перерасчёт за прошлый месяц?", "house": "Д-10", "category": "Электричество", "additional": "Начисления и оплата", "urgency": "Срочно", "recipient": "Инженерная служба", "review": 0, "source_date": "11.06.2026"}, {"id": "О-031", "text": "В ванной медленно уходит вода, засор где-то в общем стояке, у соседей то же самое", "house": "Д-09", "category": "Вода и канализация", "additional": "", "urgency": "Обычная", "recipient": "Инженерная служба", "review": 0, "source_date": "31.10.2025"}, {"id": "О-032", "text": "мигает свет в лифтовом холле 1 этаж весь день мигает глаза болят.", "house": "Д-08", "category": "Электричество", "additional": "", "urgency": "Обычная", "recipient": "Инженерная служба", "review": 0, "source_date": "19.02.2026"}, {"id": "О-033", "text": "На газоне паркуются машины, всё перекопали колёсами", "house": "Д-08", "category": "Соседи и порядок", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 0, "source_date": "30.03.2026"}, {"id": "О-034", "text": "Прошу сделать перерасчёт за вывоз мусора, мы три месяца не жили в квартире", "house": "Д-11", "category": "Начисления и оплата", "additional": "", "urgency": "Обычная", "recipient": "Расчётный центр", "review": 1, "source_date": "25.10.2025"}, {"id": "О-035", "text": "Подсветка номера дома не горит, курьеры не могут найти подъезд.", "house": "Д-05", "category": "Электричество", "additional": "", "urgency": "Обычная", "recipient": "Инженерная служба", "review": 0, "source_date": "24.02.2026"}, {"id": "О-036", "text": "С 9 утра нет воды вообще, ни горячей, ни холодной. Предупреждений не было", "house": "Д-05", "category": "Вода и канализация", "additional": "", "urgency": "Срочно", "recipient": "Инженерная служба", "review": 0, "source_date": "12.11.2025"}, {"id": "О-037", "text": "Входная дверь перестала нормально закрываться, перекосило, замок заедает.", "house": "Д-11", "category": "Дефект в квартире", "additional": "", "urgency": "Обычная", "recipient": "Гарантийный отдел", "review": 1, "source_date": "13.07.2026"}, {"id": "О-038", "text": "Пожилая соседка застряла в лифте, говорит, что ей плохо. Мы на 4 этаже, третий подъезд.", "house": "Д-03", "category": "Лифт", "additional": "", "urgency": "Авария", "recipient": "Аварийно-диспетчерская служба", "review": 1, "source_date": "22.05.2026"}, {"id": "О-039", "text": "Сосед занял часть общего коридора, поставил шкаф и дверь.", "house": "Д-07", "category": "Соседи и порядок", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 0, "source_date": "26.02.2026"}, {"id": "О-040", "text": "у мусоропровода на 5 этаже воняет ужасно уже неделю.", "house": "Д-10", "category": "Уборка и благоустройство", "additional": "", "urgency": "Обычная", "recipient": "Клининг и благоустройство", "review": 0, "source_date": "11.04.2026"}, {"id": "О-041", "text": "Не приходит квитанция на почту второй месяц", "house": "Д-02", "category": "Начисления и оплата", "additional": "", "urgency": "Обычная", "recipient": "Расчётный центр", "review": 0, "source_date": "28.11.2025"}, {"id": "О-042", "text": "Сосед держит в квартире много кошек, запах на весь этаж.", "house": "Д-07", "category": "Соседи и порядок", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 0, "source_date": "31.03.2026"}, {"id": "О-043", "text": "Соседи затопили нас неделю назад и отказываются возмещать, что делать?", "house": "Д-06", "category": "Соседи и порядок", "additional": "", "urgency": "Обычная", "recipient": "Отдел по работе с жителями", "review": 0, "source_date": "19.05.2026"}, {"id": "О-044", "text": "Просим установить велопарковку у второго подъезда, велосипеды стоят в холле.", "house": "Д-12", "category": "Уборка и благоустройство", "additional": "", "urgency": "Обычная", "recipient": "Клининг и благоустройство", "review": 0, "source_date": "22.04.2026"}, {"id": "О-045", "text": "Дорожку к школе не почистили от с